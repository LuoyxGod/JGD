    / 17.0, 15.0 / 17.0, 7.0 / 17.0,\\r\\n      4.0 / 17.0, 12.0 / 17.0, 2.0 / 17.0,
    10.0 / 17.0,\\r\\n      16.0 / 17.0, 8.0 / 17.0, 14.0 / 17.0, 6.0 / 17.0\\r\\n 
    };\\r\\n  uint index = (uint(uv.x) % 4) * 4 + uint(uv.y) % 4;\\r\\n  clip(In
    - DITHER_THRESHOLDS[index]);\\r\\n  Out = 0.5;\"\n}\n\n{\n    \"m_SGVersion\":
