    \"\",\n    \"m_FunctionSourceUsePragmas\": true,\n    \"m_FunctionBody\": \"float2
    uv = ScreenPosition.xy;\\r\\n  float DITHER_THRESHOLDS[16] =\\r\\n  {\\r\\n     
